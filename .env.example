# AI settings for the /extract endpoint, which reads the answers from a scanned or photographed form.
# The other endpoints (/schema, /response, /pdf) work without them.
#
# Setup:
#   1. Copy this file to .env:   cp .env.example .env
#   2. Choose a provider and fill in its key below.
#   3. Restart the service. `npm run dev` and `npm start` load .env from the project root.
#      In Docker, pass the file to the container:   docker run --env-file .env ...
#
# .env is ignored by Git. Never commit API keys and never put them in the source code.

# The AI provider: openai, anthropic, or ollama.
# If it is empty, the service uses the provider whose API key is set (OpenAI first).
AI_PROVIDER=

# A vision-capable model of the chosen provider, for example, gpt-4o.
# If it is empty, the provider's default model is used.
AI_MODEL=

# OpenAI. Create a key at https://platform.openai.com/api-keys
# Documents are sent to the OpenAI API.
OPENAI_API_KEY=

# Anthropic. Create a key at https://console.anthropic.com/settings/keys
# Documents are sent to the Anthropic API.
ANTHROPIC_API_KEY=

# Ollama. No key is required: documents are processed by a model on your own server.
# Pull a vision model (for example: ollama pull llama3.2-vision), then set AI_PROVIDER=ollama
# and AI_MODEL to the name of that model. Ollama does not accept PDF files, only images.
OLLAMA_BASE_URL=http://localhost:11434
